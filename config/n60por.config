# ----------------------------------------------------------------
# 目标硬件平台配置 (Netcore N60 Pro 2GB)
# ----------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y

# 核心系统
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_DEFAULT_zram-swap=y

# ----------------------------------------------------------------
# 1. Docker 核心依赖 (不构建 App，只构建内核底层)
# ----------------------------------------------------------------
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_kmod-cgroup-cpu=y
CONFIG_PACKAGE_kmod-cgroup-cpuset=y
CONFIG_PACKAGE_kmod-cgroup-freezer=y
CONFIG_PACKAGE_kmod-cgroup-memory=y           # 修正：原 mem → memory
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_cgroupfs-mount=y
# 排除应用包
# CONFIG_PACKAGE_luci-app-docker is not set
# CONFIG_PACKAGE_dockerd is not set

# ----------------------------------------------------------------
# 2. 科学上网核心依赖 (不构建 App，只构建加密/分流底层)
# ----------------------------------------------------------------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
# 排除应用包
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# ----------------------------------------------------------------
# 3. 磁盘与 IO 驱动 (确保 SSD 性能，方便后期 Docker 挂载)
# ----------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ----------------------------------------------------------------
# 4. 无线与网络驱动 (开源驱动，稳定无冲突)
# ----------------------------------------------------------------
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y
# 禁用闭源驱动
# CONFIG_PACKAGE_kmod-mt_wifi is not set

# ----------------------------------------------------------------
# 5. 系统工具 (保留必要的维护工具)
# ----------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# ----------------------------------------------------------------
# 6. 默认网络组件
# ----------------------------------------------------------------
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_odhcpd-extras=y
CONFIG_DEFAULT_firewall=y
CONFIG_DEFAULT_ip6tables=y
CONFIG_DEFAULT_iptables=y
CONFIG_DEFAULT_ppp=y
CONFIG_DEFAULT_ppp-mod-pppoe=y
CONFIG_DEFAULT_fstools=y

# ----------------------------------------------------------------
# 编译优化
# ----------------------------------------------------------------
# CONFIG_KERNEL_DEBUG_INFO is not set
CONFIG_STRIP_KERNEL_EXPORTS=y
