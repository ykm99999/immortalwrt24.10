# ============================================================
# Netcore N60 Pro 2G 官方版 - 性能完全榨干配置 (终极版)
# 基于 ImmortalWrt 24.10, Kernel 6.6
# ============================================================

# ----------------- 目标平台 -----------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y

# ----------------- 核心系统 -----------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_DEFAULT_zram-swap=y

# ================= 内核极致性能 =================
# CPU 固定最高频率 (禁用动态调频)
CONFIG_KERNEL_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_KERNEL_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_KERNEL_CPU_FREQ_STAT=y
CONFIG_KERNEL_DT_MTK_PVT_ENABLE=y          # 固定频率，绕过温度降频

# 抢占式内核 + 高精度定时器 + 完全抢占
CONFIG_KERNEL_PREEMPT=y
CONFIG_KERNEL_PREEMPT_VOLUNTARY=n
CONFIG_KERNEL_PREEMPT_FULL=y
CONFIG_KERNEL_HIGH_RES_TIMERS=y
CONFIG_KERNEL_NO_HZ_FULL=y                 # 减少系统时钟中断

# 网络内存与缓冲区最大化
CONFIG_KERNEL_NET_CORE_RMEM_DEFAULT=262144
CONFIG_KERNEL_NET_CORE_WMEM_DEFAULT=262144
CONFIG_KERNEL_NET_IP_TCP_MEM="262144 524288 1048576"
CONFIG_KERNEL_NET_IP_TCP_RMEM=262144
CONFIG_KERNEL_NET_IP_TCP_WMEM=262144
CONFIG_KERNEL_NET_CORE_RMEM_MAX=33554432
CONFIG_KERNEL_NET_CORE_WMEM_MAX=33554432
CONFIG_KERNEL_NETDEV_BUDGET=600
CONFIG_KERNEL_NETDEV_BUDGET_USEC=0

# TCP 拥塞控制 BBR + 全锥形 NAT + 其他优化
CONFIG_DEFAULT_BBR=y
CONFIG_KERNEL_NETFILTER_NAT_FULL_CONE=y
CONFIG_KERNEL_TCP_CONG_BBR=y
CONFIG_KERNEL_TCP_CONG_ADVANCED=y
CONFIG_KERNEL_TCP_MD5SIG=y
CONFIG_KERNEL_NET_SCH_FQ_CODEL=y            # 队列管理
CONFIG_KERNEL_NET_SCH_CAKE=y               # Cake 队列

# 高级网络特性
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_NET_CLS_BPF=y
CONFIG_KERNEL_NET_ACT_BPF=y
CONFIG_KERNEL_NET_SCH_INGRESS=y
CONFIG_KERNEL_NET_CLS_FLOWER=y

# 多核与中断优化
CONFIG_KERNEL_SMP=y
CONFIG_KERNEL_NR_CPUS=4
CONFIG_KERNEL_IRQ_DOMAIN_HIERARCHY=y
CONFIG_KERNEL_IRQ_TIME_ACCOUNTING=y
CONFIG_PACKAGE_irqbalance=y

# ================= Docker 完整内核依赖 =================
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_kmod-cgroup-cpu=y
CONFIG_PACKAGE_kmod-cgroup-cpuset=y
CONFIG_PACKAGE_kmod-cgroup-freezer=y
CONFIG_PACKAGE_kmod-cgroup-memory=y
CONFIG_PACKAGE_kmod-cgroup-pids=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_cgroupfs-mount=y
# 排除 App
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-docker is not set

# ================= 科学上网内核依赖 =================
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y

# ================= 无线与硬件加速 =================
# 开源无线驱动 + 无线卸载
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y

# 硬件 NAT 双 PPE + 其他加速
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-mediatek_hnat_ppe=y
CONFIG_PACKAGE_kmod-mediatek_hnat_ppe2=y
CONFIG_PACKAGE_kmod-mediatek_hnat_mtk=y
# 以下为内核级选项（通过 kernel_menuconfig 确保）
# CONFIG_NET_MEDIATEK_HNAT=y
# CONFIG_NET_MEDIATEK_PPE_ENABLE_DS_PPE2=y

# 禁用闭源驱动
# CONFIG_PACKAGE_kmod-mt_wifi is not set

# ================= USB 与存储极限 =================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-scsi-core=y          # UAS 依赖
CONFIG_PACKAGE_kmod-scsi-generic=y

# ================= 系统工具与监控 =================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-turboacc=y        # 集成软件/硬件加速开关
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nload=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_tcpdump=y

# ================= 网络基础组件 =================
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_odhcpd-extras=y
CONFIG_DEFAULT_firewall=y
CONFIG_DEFAULT_ip6tables=y
CONFIG_DEFAULT_iptables=y
CONFIG_DEFAULT_ppp=y
CONFIG_DEFAULT_ppp-mod-pppoe=y
CONFIG_DEFAULT_fstools=y

# ================= 编译优化 =================
# CONFIG_KERNEL_DEBUG_INFO is not set
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
CONFIG_USE_SSTRIP=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -mcpu=cortex-a53"   # 最高优化等级
CONFIG_TARGET_CFLAGS="-O3 -pipe"

# 排除多设备编译，仅本设备
# CONFIG_TARGET_MULTI_PROFILE is not set
