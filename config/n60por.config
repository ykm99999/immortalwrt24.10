# 适用于 Netcore N60 Pro (2G 官方版)
# 精简配置：不包含 PassWall2 和 Docker 用户空间程序
# 编译后固件体积约 40-60 MB

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60-pro=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y

# 核心功能
CONFIG_IPV6=y
CONFIG_KERNEL_CGROUPS=y          # 内核级，Docker 需要
CONFIG_KERNEL_NAMESPACES=y       # 内核级，Docker 需要
CONFIG_KERNEL_VETH=y             # 内核级，Docker 需要
CONFIG_KERNEL_BRIDGE=y           # 内核级，Docker 需要
CONFIG_KERNEL_OVERLAY_FS=y       # 内核级，Docker 需要
CONFIG_PACKAGE_kmod-tun=y        # TUN 模块，科学上网常用
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-mmc=y

# 无线驱动
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y

# 自动挂载
CONFIG_PACKAGE_automount=y

# 常用工具
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_kmod-fs-nfs=y
CONFIG_PACKAGE_kmod-fs-nfs-common=y
CONFIG_PACKAGE_kmod-fs-nfs-v3=y
CONFIG_PACKAGE_kmod-fs-nfs-v4=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_odhcpd-extras=y

# 默认配置
CONFIG_DEFAULT_autocore-arm=y
CONFIG_DEFAULT_automount=y
CONFIG_DEFAULT_ppp=y
CONFIG_DEFAULT_ppp-mod-pppoe=y
CONFIG_DEFAULT_firewall=y
CONFIG_DEFAULT_fstools=y
CONFIG_DEFAULT_ip6tables=y
CONFIG_DEFAULT_iptables=y
CONFIG_DEFAULT_odhcpd-ipv6only=y
CONFIG_DEFAULT_odhcpd=y
CONFIG_DEFAULT_swconfig=y
CONFIG_DEFAULT_wget=y
CONFIG_DEFAULT_zram-swap=y
