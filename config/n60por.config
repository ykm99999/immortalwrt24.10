# ================================================================
# 磊科 N60 Pro 2G 官方版 - 终极性能榨干配置 (纯净内核依赖版)
# 基于开源无线驱动 + MT7986 平台通用优化
# 修复版本 v1.1
# ================================================================

# ------------------------- 目标平台 -------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y

# ----------------------- 核心系统 -------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_DEFAULT_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

# --------------------- 内核极致性能调优 ---------------------
CONFIG_KERNEL_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_KERNEL_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_KERNEL_PREEMPT=y
CONFIG_KERNEL_HIGH_RES_TIMERS=y
CONFIG_KERNEL_NET_CORE_RMEM_DEFAULT=262144
CONFIG_KERNEL_NET_CORE_WMEM_DEFAULT=262144
CONFIG_KERNEL_NET_CORE_RMEM_MAX=16777216
CONFIG_KERNEL_NET_CORE_WMEM_MAX=16777216
CONFIG_KERNEL_NETFILTER_NAT_FULL_CONE=y
CONFIG_DEFAULT_BBR=y
CONFIG_KERNEL_FQ_CODEL=y
CONFIG_KERNEL_FQ=y
CONFIG_DEFAULT_squashfs=y

# --------------------- Docker 内核模块（仅依赖） ---------------------
CONFIG_PACKAGE_kmod-cgroup-cpu=y
CONFIG_PACKAGE_kmod-cgroup-cpuset=y
CONFIG_PACKAGE_kmod-cgroup-freezer=y
CONFIG_PACKAGE_kmod-cgroup-memory=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_cgroupfs-mount=y
# 以下不启用（应用后装）
# CONFIG_PACKAGE_docker-ce is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_docker-compose is not set

# --------------------- 科学上网内核模块（仅依赖） ---------------------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libmbedtls=y
# 以下不启用（应用后装）
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set

# --------------------- 无线与硬件加速 ---------------------
# 开源无线驱动（稳定推荐）
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y

# 硬件与软件流量加速
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_irqbalance=y

# 禁用闭源驱动
# CONFIG_PACKAGE_kmod-mt_wifi is not set

# --------------------- USB 与存储极限 ---------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
# CONFIG_PACKAGE_kmod-fs-ntfs3=y  # 移至可选，需时启用
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-scsi-core=y

# --------------------- 系统工具与网络组件 ---------------------
# 基础 LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-turboacc=y

# 网络诊断与调优工具
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ebtables=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_iproute2=y

# 系统监控与分区工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_odhcpd-extras=y

# 常用系统工具（补充）
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE unzip=y
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_blockdev=y
CONFIG_PACKAGE_mount-utils=y

# 默认防火墙与 PPPoE
CONFIG_DEFAULT_firewall=y
CONFIG_DEFAULT_ip6tables=y
CONFIG_DEFAULT_iptables=y
CONFIG_DEFAULT_ppp=y
CONFIG_DEFAULT_ppp-mod-pppoe=y
CONFIG_DEFAULT_fstools=y

# --------------------- 编译优化（绕过 libc.so 错误） ---------------------
CONFIG_USE_MKLIBS=n
CONFIG_STRIP_KERNEL_EXPORTS=n
CONFIG_USE_SSTRIP=y
# CONFIG_KERNEL_DEBUG_INFO is not set
CONFIG_STRIP=y
CONFIG_TARGET_OPTIONS=y

# --------------------- 网络增强 ---------------------
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_iptables-mod-filter=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_kmod-nf-nathelp-extra=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# --------------------- 时间与语言支持 ---------------------
CONFIG_PACKAGE_tzdata=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_zoneinfo=y
CONFIG_ENOUGH_TIMEZONE_DATA=y

# --------------------- 其他必要组件 ---------------------
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libjson-script=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y

# --------------------- 可选：NTFS 支持（如需请取消注释） ---------------------
# CONFIG_PACKAGE_kmod-fs-ntfs3=y
# CONFIG_PACKAGE_ntfs-3g=y

# --------------------- 调试开关（如需请取消注释） ---------------------
# CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_KERNEL=y
# CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

# --------------------- IPv6 支持 ---------------------
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y
CONFIG_DEFAULT_dnsmasq=y
CONFIG_DEFAULT_dnsmasq_config_authentication=y
CONFIG_PACKAGE_dnsmasq=y
