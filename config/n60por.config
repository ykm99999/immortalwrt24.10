# ================================================================
# 磊科 N60 Pro 2G 官方版 - 精简高性能固件配置
# 目标：最小体积、极致性能、仅内置 SSR Plus+
# 版本：v2.0 - 最终版
# ================================================================

# ------------------------- 目标平台 -------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y

# ----------------------- 核心系统 -------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_DEFAULT_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

# --------------------- 内核极致性能调优 ---------------------
CONFIG_KERNEL_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_KERNEL_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_KERNEL_PREEMPT=y
CONFIG_KERNEL_HIGH_RES_TIMERS=y
CONFIG_KERNEL_NET_CORE_RMEM_DEFAULT=262144
CONFIG_KERNEL_NET_CORE_WMEM_DEFAULT=262144
CONFIG_KERNEL_NET_CORE_RMEM_MAX=16777216
CONFIG_KERNEL_NET_CORE_WMEM_MAX=16777216
CONFIG_KERNEL_NETFILTER_NAT_FULL_CONE=y
CONFIG_DEFAULT_BBR=y

# --------------------- Docker 内核模块（仅依赖，应用后装） ---------------------
CONFIG_PACKAGE_kmod-cgroup-cpu=y
CONFIG_PACKAGE_kmod-cgroup-cpuset=y
CONFIG_PACKAGE_kmod-cgroup-freezer=y
CONFIG_PACKAGE_kmod-cgroup-memory=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_cgroupfs-mount=y
# 以下不启用（应用后装）
# CONFIG_PACKAGE_docker-ce is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_docker-compose is not set

# --------------------- 科学上网 (仅 SSR Plus+ 及核心) ---------------------
# 内核级依赖
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libmbedtls=y

# SSR Plus+ 主程序及语言包
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# 代理核心 (确保开箱即用)
CONFIG_PACKAGE_xray-core=y
# CONFIG_PACKAGE_sing-box=y   # 可选，按需启用

# --------------------- 无线与硬件加速 ---------------------
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_irqbalance=y
# CONFIG_PACKAGE_kmod-mt_wifi is not set

# --------------------- USB 与存储 ---------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-scsi-core=y

# --------------------- 基础 LuCI 与工具 ---------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-turboacc=y

# 最小化网络工具集
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_miniupnpd=y

# 最小化系统工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_e2fsprogs=y

# --------------------- DNS/DHCP ---------------------
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y

# --------------------- 防火墙与 PPPoE ---------------------
CONFIG_DEFAULT_firewall=y
CONFIG_DEFAULT_ip6tables=y
CONFIG_DEFAULT_iptables=y
CONFIG_DEFAULT_ppp=y
CONFIG_DEFAULT_ppp-mod-pppoe=y
CONFIG_DEFAULT_fstools=y

# --------------------- 编译优化 ---------------------
CONFIG_USE_MKLIBS=n
CONFIG_STRIP_KERNEL_EXPORTS=n
CONFIG_USE_SSTRIP=y
CONFIG_STRIP=y
# CONFIG_KERNEL_DEBUG_INFO is not set

# --------------------- 网络增强 ---------------------
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# --------------------- 系统必要组件 ---------------------
CONFIG_PACKAGE_tzdata=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y

# --------------------- IPv6 支持 ---------------------
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y

# --------------------- 以下均为禁用项 ---------------------
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_docker-ce is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set
# CONFIG_PACKAGE_openssh-sftp-server is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_bsdtar is not set
# CONFIG_PACKAGE_resize2fs is not set
# CONFIG_PACKAGE_blkid is not set
# CONFIG_PACKAGE_blockdev is not set
# CONFIG_PACKAGE_mount-utils is not set
# CONFIG_PACKAGE_ip-bridge is not set
# CONFIG_PACKAGE_ebtables is not set
# CONFIG_PACKAGE_tc is not set
# CONFIG_PACKAGE_iproute2 is not set
# CONFIG_PACKAGE_odhcpd-extras is not set
