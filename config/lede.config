# === Target System ===
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y

# === Global build settings ===
CONFIG_ALL_KMODS=y
CONFIG_ALL_NONSHARED=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="LEDE"
CONFIG_VERSION_REPO="https://github.com/coolsnowwolf/lede"
CONFIG_VERSION_NICK="N60-PRO-RESCUE"

# === Advanced configuration (for rescue) ===
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
# 移除冲突项：CONFIG_TARGET_ROOTFS_INITRAMFS_ZSTD 不设置
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=n

# === Kernel modules (drivers) ===
# USB 3.0 support
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# NAND/UBI tools (critical for rescue)
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_mtd-utils-ubi=y

# Filesystem tools
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_partx-utils=y

# Network tools (emergency recovery)
CONFIG_PACKAGE_tftp-hpa=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump-mini=y

# Bootloader update tools
CONFIG_PACKAGE_uboot-envtools=y
# 禁用官方 uboot-mediatek，因为我们使用自定义 U-Boot
# CONFIG_PACKAGE_uboot-mediatek is not set

# Shell & script (精简 initramfs，去掉 python3-light 以减小体积)
CONFIG_PACKAGE_bash=y
# CONFIG_PACKAGE_python3-light is not set

# WiFi and Ethernet drivers
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_kmod-mt76x2-common=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_mt7986-wo-firmware=y
# 2.5G PHY 驱动（N60 PRO 通常使用 Realtek RTL8221B）
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y

# UCI & Luci (可选，为方便调试保留 Luci)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Debug / Rescue helpers (保留必要工具，vim 改用较小体积版本)
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_vim=y          # vim-fuller 过大，改用 vim
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# Final tweaks
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
CONFIG_USE_SSTRIP=y
